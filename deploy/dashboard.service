# /etc/systemd/system/dashboard.service
[Unit]
Description=Personal dashboard (Telegram Mini App backend)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/dashboard
# Секреты: токен бота, GitHub PAT, TELEGRAM_ALLOWED_USER_ID. Файл root:root 600, systemd читает его до сброса прав
EnvironmentFile=/etc/dashboard/env
Environment=DASHBOARD_ADDR=127.0.0.1:8090
Environment=DASHBOARD_DB=/var/lib/dashboard/dashboard.db
Restart=on-failure
RestartSec=3

# Без своего пользователя: временный uid, база в /var/lib/dashboard
DynamicUser=yes
StateDirectory=dashboard
StateDirectoryMode=0700

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
