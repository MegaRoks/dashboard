# Скопируйте в server/.env (он в .gitignore). На сервере те же переменные лежат в EnvironmentFile systemd.

# Токен бота от @BotFather: им Telegram подписывает initData
TELEGRAM_BOT_TOKEN=
# Ваш Telegram user id — единственный, кому API отдаёт данные. Чужие id видны в логе как «user is not allowed»
TELEGRAM_ALLOWED_USER_ID=

# Fine-grained PAT: Repository access — репозитории треков; permissions — Contents: Read, Metadata: Read
GITHUB_TOKEN=

# Адрес дашборда: изменяющие запросы принимаются только с этим Origin. Локально — http://localhost:8090
DASHBOARD_ORIGIN=https://dashboard.apisky.org

# Необязательные
# DASHBOARD_ADDR=127.0.0.1:8090
# DASHBOARD_DB=dashboard.db
# DASHBOARD_TZ=Europe/Moscow
# INITDATA_TTL=10m
# SESSION_TTL=720h
